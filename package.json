{
  "name": "lyricwave",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:site": "vinext dev",
    "dev:engine": "node scripts/run-python.mjs -m uvicorn backend.server:app --host 127.0.0.1 --port 8008",
    "setup:engine": "node scripts/setup-engine.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node --test tests/rendered-html.test.mjs tests/lyric-timing.test.mjs tests/lyric-timeline.test.mjs tests/local-engine.test.mjs tests/local-runtime.test.mjs tests/lyric-export.test.mjs",
    "test:python": "node scripts/run-python.mjs -m unittest backend -v",
    "test": "npm run build && npm run test:frontend && npm run test:python",
    "benchmark:lyrics": "node scripts/run-python.mjs scripts/evaluate-lyrics.py",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .venv --ignore-pattern .local-data",
    "check": "npm run lint && npm run typecheck && npm run test",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/workers-types": "^5.20260817.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module"
}
