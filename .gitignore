# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Python / local inference
__pycache__/
*.py[cod]
/.venv/
/.local-data/
/.cache/
/.huggingface/
/hf-cache/
/models/
/checkpoints/
*.ckpt
*.onnx
*.pt
*.pth
*.safetensors
*.gguf

# Local songs and generated stems
*.aac
*.flac
*.m4a
*.mp3
*.ogg
*.wav
*.webm
/separated/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev.log
*.tsbuildinfo
/.engine.log
/.engine.err.log
/.engine.out.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/public/__local-test-*.ogg
